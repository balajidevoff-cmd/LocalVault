# LocalVault Environment Variables Example
# Copy to .env and adjust values for your environment. Never commit production secrets.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Storage Directory (Absolute or relative to project root)
# Windows example: D:/All files/Cloud storage/data/storage or C:/LocalVaultData/storage
LOCALVAULT_STORAGE_PATH=../../data/storage

# SQLite Database File Path
LOCALVAULT_DB_PATH=../../data/db/localvault.db

# Storage Quotas & Limits
# 250 GB in bytes: 268435456000
LOCALVAULT_STORAGE_QUOTA_BYTES=268435456000
# 10 GB max upload file size in bytes: 10737418240
LOCALVAULT_MAX_UPLOAD_SIZE_BYTES=10737418240

# Security (Generate a secure random string for production: `openssl rand -hex 32`)
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# User Policies
ALLOW_REGISTRATION=true

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

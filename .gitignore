# LocalVault .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
backend/lib/
backend/lib64/
!**/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node / Web / Mobile
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.expo/
.expo-shared/
*.tsbuildinfo
*.log

# Android Native Builds
*.apk
*.aab
.gradle/
local.properties

# Local Storage, Data & Backups (CRITICAL: Never commit user files or SQLite DBs)
data/storage/*
!data/storage/.gitkeep
data/db/*
!data/db/.gitkeep
data/backups/*
!data/backups/.gitkeep
*.db
*.sqlite
*.sqlite3

# Environment and Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
config/tunnel/*
!config/tunnel/.gitkeep
logs/
*.log


# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
